# Copy this file to .env and fill in your values.
# The .env file is gitignored - never commit it.

# Inline comments are not supported in .env files, so remove when inputing real values.
# The default file/location to name/place this for systemctl is /etc/default/telegraf


# InfluxDB
INFLUXDB_HOST=192.168.x.x        # IP of the machine running InfluxDB
INFLUXDB_TOKEN=your_token_here   # Admin token from InfluxDB UI -> API Tokens

# MQTT (Mosquitto)
MQTT_HOST=192.168.x.x            # IP of the machine running Mosquitto
TELEGRAF_MQTT_PASSWORD=your_pw   # Set with: docker exec mosquitto mosquitto_passwd /mosquitto/config/pwfile telegraf

# Host IPs (for reference / SSH in scripts)
INFLUXDB_HOST=192.168.x.x        # Tower / Unraid server
MQTT_HOST=192.168.x.x            # HA Pi running Mosquitto + Node-RED
DESKTOP_IP=192.168.x.x
LAPTOP_IP=192.168.x.x
PIHOLE_IP=192.168.x.x
ROUTER_IP=192.168.1.1
STEAMMACHINE_IP=192.168.x.x

# Hostnames (if you use mDNS / local DNS)
HA_HOST=homeassistant.lan
HA_USER=your-ssh-user
PIHOLE_HOST=pihole.lan
